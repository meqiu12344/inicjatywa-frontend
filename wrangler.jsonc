{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "inicjatywa-frontend",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // Środowisko testowe: osobny worker pod test.inicjatywakatolicka.pl, backend api-test.
    // Deploy: `npm run deploy:test` (buduje z NEXT_PUBLIC_APP_ENV=test).
    "test": {
      "name": "inicjatywa-frontend-test",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "routes": [
        { "pattern": "test.inicjatywakatolicka.pl", "custom_domain": true }
      ],
      "vars": {
        "BACKEND_URL": "https://api-test.inicjatywakatolicka.pl",
        "NEXT_PUBLIC_APP_ENV": "test"
      }
    }
  }
}
